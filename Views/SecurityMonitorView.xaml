<Page x:Class="WindowsGuardianWatchdog.Views.SecurityMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/LogoMark.png" Width="64" Height="64" Stretch="UniformToFill"/>
                <TextBlock Text="Security Monitor" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartButton" Content="Start Monitoring" Click="StartButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="StopButton" Content="Stop Monitoring" Click="StopButton_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button Content="Refresh processes" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="End selected" Click="EndSelectedButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                <Button Content="End nonessential" Click="EndNonessentialButton_Click" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
            <TextBlock x:Name="ProcessStatusText" Text="Loading processes…" Foreground="{StaticResource AccentCyanBrush}"/>

            <TextBlock Text="All processes" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <ListView x:Name="ProcessesListView" Height="520" SelectionMode="Multiple" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="12" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Importance}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding MemoryUsageText}" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding Path}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="6" Content="End" Click="EndTaskButton_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Padding="10,4" FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

