<Page x:Class="WindowsGuardianWatchdog.Views.SecurityMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="What is running" Rank="6" Priority="Optional"
                             Summary="A list of every program open on this PC, with how important it is."
                             Why="Use this when the PC feels slow. Protected means Windows needs it, so leave it alone. Normal means you can close it if you know what it is. Close extras stops the normal ones and leaves Windows, virus protection, and this app running."/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartButton" Content="Watch for changes" Click="StartButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="StopButton" Content="Stop watching" Click="StopButton_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button Content="Refresh the list" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Close selected" Click="EndSelectedButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                <Button Content="Close extras" Click="EndNonessentialButton_Click" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
            <TextBlock x:Name="ProcessStatusText" Text="Loading programs…" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>

            <TextBlock Text="Every program, busiest first" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Grid ColumnSpacing="12" Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Grid.Column="1" Text="Program" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Grid.Column="2" Text="Importance" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Grid.Column="3" Text="Urgency" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Grid.Column="4" Text="Memory" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Grid.Column="5" Text="Where it lives" Style="{StaticResource EyebrowTextStyle}"/>
            </Grid>
            <TextBlock Text="Importance: Protected is required by Windows. Normal can be closed. Urgency is how much attention Windows is giving that program. Memory is how much of the PC it is using right now." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            <ListView x:Name="ProcessesListView" Height="520" SelectionMode="Multiple" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="12" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Id}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Importance}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock Grid.Column="4" Text="{Binding MemoryUsageText}" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding Path}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="6" Content="End" Click="EndTaskButton_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Padding="10,4" FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

