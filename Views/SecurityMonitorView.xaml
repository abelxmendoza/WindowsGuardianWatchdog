<Page x:Class="WindowsGuardianWatchdog.Views.SecurityMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/LogoMark.png" Width="64" Height="64" Stretch="UniformToFill"/>
                <TextBlock Text="Security Monitor" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartButton" Content="Start Monitoring" Click="StartButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="StopButton" Content="Stop Monitoring" Click="StopButton_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="Active Processes" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <ListView x:Name="ProcessesListView" Height="400" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Id}" Width="80" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding Name}" Width="200" Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding MemoryUsageText}" Width="120" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Path}" Width="300" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            <Button Content="End Task" 
                                    Click="EndTaskButton_Click" 
                                    Tag="{Binding Id}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="10,0,0,0"
                                    Padding="10,5"
                                    FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

