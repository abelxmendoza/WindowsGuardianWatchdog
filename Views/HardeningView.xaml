<Page x:Class="WindowsGuardianWatchdog.Views.HardeningView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="32" Spacing="18" MaxWidth="1500">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="58" Height="58" CornerRadius="12" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                    <Image Source="ms-appx:///Resources/LogoMark.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Security hardening" Style="{StaticResource PageTitleTextStyle}"/>
                    <TextBlock Text="Turn on the same kind of baseline the Linux Guardian applies to a fresh machine." Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource HeroCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="THIS PC" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DefenderStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="One administrator prompt"
                     Message="The checked controls are the safe baseline. Attack surface reduction and Controlled Folder Access are left unchecked because they can block older apps. Apply the full baseline when you want every control."/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ApplyButton" Content="Harden this PC" Command="{Binding ApplySelectedCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="ApplyAllButton" Content="Apply full baseline" Command="{Binding ApplyAllCommand}" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="VerifyButton" Content="Check status" Command="{Binding VerifyCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="RollbackButton" Content="Roll back" Click="RollbackButton_Click" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource EyebrowTextStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Last run" Style="{StaticResource SectionTitleTextStyle}"/>
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
