<Page x:Class="WindowsGuardianWatchdog.Views.HardeningView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="32" Spacing="18" MaxWidth="1500">
            <guide:PageGuide Title="Turn on protection" Rank="2" Priority="Do this first"
                             Summary="These are Windows' own safety switches. The checked ones are the everyday set."
                             Why="Turning these on does not delete files or change your passwords. The ones marked Careful can block an older app, so they stay unchecked until you decide you want them."/>

            <Border Style="{StaticResource HeroCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="THIS PC" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding SummaryText}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DefenderStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Windows will ask once"
                     Message="Turn on the checked items is the right choice for most people. Turn on everything also includes the Careful items. Undo the last change puts the previous settings back."/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ApplyButton" Content="Turn on the checked items" Command="{Binding ApplySelectedCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="ApplyAllButton" Content="Turn on everything" Command="{Binding ApplyAllCommand}" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="VerifyButton" Content="Check what is already on" Command="{Binding VerifyCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="RollbackButton" Content="Undo the last change" Click="RollbackButton_Click" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <TextBlock Text="{Binding Priority}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Why}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Last run" Style="{StaticResource SectionTitleTextStyle}"/>
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
