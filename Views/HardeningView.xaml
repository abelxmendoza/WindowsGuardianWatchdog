<Page x:Class="WindowsGuardianWatchdog.Views.HardeningView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/Logo.png" Width="64" Height="64" Stretch="Uniform"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Security Hardening" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <TextBlock Text="One-click Windows security baseline" FontSize="14" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Defender Status -->
            <Border Style="{StaticResource CardStyle}" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="Windows Defender Status" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <TextBlock Text="{Binding DefenderStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ApplyButton" Content="Apply Security Baseline" 
                        Command="{Binding ApplyHardeningCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="RollbackButton" Content="Rollback Changes" 
                        Command="{Binding RollbackCommand}"
                        Style="{StaticResource DangerButtonStyle}"/>
                <Button x:Name="VerifyButton" Content="Verify Status" 
                        Command="{Binding VerifyCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <!-- Status Text -->
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="{StaticResource AccentCyanBrush}" 
                       FontSize="14" 
                       Margin="0,10,0,0"/>

            <!-- Available Rules -->
            <TextBlock Text="Available Hardening Rules" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,10"/>
            <ListView ItemsSource="{Binding AvailableRules}" Height="200" Background="{StaticResource BackgroundNoiseBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,2,0,2">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                    <TextBlock Text="Severity:" Foreground="{StaticResource TextGrayBrush}"/>
                                    <TextBlock Text="{Binding Severity}" Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="Requires Admin:" Foreground="{StaticResource TextGrayBrush}" Margin="20,0,0,0"/>
                                    <TextBlock Text="{Binding RequiresAdmin}" Foreground="{StaticResource AccentCyanBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Results -->
            <TextBlock Text="Hardening Results" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,10"/>
            <ListView ItemsSource="{Binding Results}" Height="300" Background="{StaticResource BackgroundNoiseBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,2,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <StackPanel Spacing="5" Width="400">
                                    <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextGrayBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Width="100">
                                    <Run Text="Status: " Foreground="{StaticResource TextGrayBrush}"/>
                                    <Run x:Name="StatusRun" Text="Unknown" Foreground="{StaticResource TextGrayBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Error}" 
                                           Foreground="{StaticResource SecondaryRedBrush}" 
                                           TextWrapping="Wrap" 
                                           Width="300"/>
                                <TextBlock Text="{Binding Timestamp}" 
                                           Foreground="{StaticResource TextGrayBrush}" 
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

