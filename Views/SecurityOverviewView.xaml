<Page x:Class="WindowsGuardianWatchdog.Views.SecurityOverviewView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <!-- Header -->
            <guide:PageGuide Title="Protection details" Priority="Optional"
                             Summary="A fuller picture of virus protection, the firewall, and this PC's health."
                             Why="Home already gives the short version. Open this when you want to see each piece instead of one score."/>

            <!-- Alert Banner -->
            <Border x:Name="AlertBanner" 
                    Background="{StaticResource SecondaryRedBrush}" 
                    Padding="15" 
                    CornerRadius="8"
                    Margin="0,0,0,20"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="⚠️ Security Alerts" FontWeight="Bold" FontSize="16" Foreground="White"/>
                    <ListView x:Name="AlertsListView" ItemsSource="{Binding SecurityAlerts}" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" Margin="0,5,0,0"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Protection Strength Card -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Protection Strength" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <TextBlock x:Name="ProtectionStrengthText" 
                                   Text="{Binding ProtectionStrength}" 
                                   FontSize="48" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyanBrush}"/>
                        <StackPanel VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="Overall Security Level" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock Text="Based on active protections" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- System Health -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="System Health" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="CPU" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock x:Name="CpuUsageText" 
                                       Text="0%" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Memory" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock x:Name="MemoryUsageText" 
                                       Text="0%" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Disk" Foreground="{StaticResource TextGrayBrush}"/>
                            <TextBlock x:Name="DiskUsageText" 
                                       Text="0%" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Defender Status -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Windows Defender Status" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="RealtimeIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="Real-Time Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="CloudIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="Cloud Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="CFAIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="Controlled Folder Access" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="PUAIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="PUA Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="BehaviorIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="Behavior Monitoring" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="AntivirusIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                                <TextBlock Text="Antivirus" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Protection -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Network Protection" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="FirewallIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="Windows Firewall" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="NetworkProtectionIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="Network Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionsText" 
                                   Text="Active Connections: 0" 
                                   Foreground="{StaticResource TextGrayBrush}" 
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Browser Protection -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Browser Protection" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="FirefoxTrackingIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="Firefox Tracking Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse x:Name="CookieProtectionIndicator" Width="12" Height="12" Fill="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="Total Cookie Protection" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Refresh Button -->
            <Button Content="Refresh Status" 
                    Click="RefreshButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>

