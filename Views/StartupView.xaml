<Page x:Class="WindowsGuardianWatchdog.Views.StartupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <!-- Startup Manager View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="Startup programs" Rank="5" Priority="Optional"
                             Summary="These programs open by themselves when you sign in to Windows."
                             Why="Too many of them make the PC slow to become ready. Turn off the ones you do not need every day, such as chat apps and game launchers. Leave anything you do not recognize until you know what it is."/>

            <Button x:Name="RefreshButton" Content="Refresh the list" Click="RefreshButton_Click"
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>

            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" Margin="0,10,0,0"/>

            <TextBlock Text="Opens with Windows" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <TextBlock Text="Priority: turn off programs you rarely use. Importance: a program you use every day can stay on." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            <ListView x:Name="StartupItemsListView" Height="500" ItemsSource="{Binding StartupItems}" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Command}" FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Location: " FontSize="12" Foreground="{StaticResource TextGrayBrush}"/>
                                <TextBlock Text="{Binding Location}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text=" | Type: " FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text=" | " FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding IsEnabled}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Content="Disable" Click="DisableButton_Click" 
                                    IsEnabled="{Binding IsEnabled}" Margin="0,5,0,0" HorizontalAlignment="Left" Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

