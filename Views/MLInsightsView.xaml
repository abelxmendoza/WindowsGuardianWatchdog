<Page x:Class="WindowsGuardianWatchdog.Views.MLInsightsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ML Security Insights View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/Logo.png" Width="64" Height="64" Stretch="Uniform"/>
                <TextBlock Text="ML Security Insights" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh" Click="RefreshButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Run Analysis" Click="RunAnalysisButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" Margin="0,10,0,0"/>

            <!-- ML Status Cards -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Anomaly Score Card -->
                <Border Grid.Column="0" Margin="5" Padding="20" Background="{StaticResource BackgroundCardBrush}" 
                        CornerRadius="12" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Anomaly Score" FontSize="16" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock Text="{Binding AnomalyScoreFormatted}" FontSize="48" FontWeight="Bold" 
                                   Foreground="{StaticResource SecondaryRedBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="Higher = More Anomalous" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Baseline Status Card -->
                <Border Grid.Column="1" Margin="5" Padding="20" Background="{StaticResource BackgroundCardBrush}" 
                        CornerRadius="12" BorderBrush="{StaticResource ThemePurpleDarkBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Baseline State" FontSize="16" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock Text="{Binding BaselineStatus.State}" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentCyanBrush}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding BaselineStatus.IsTrained}" 
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Risk Trend Card -->
                <Border Grid.Column="2" Margin="5" Padding="20" Background="{StaticResource BackgroundCardBrush}" 
                        CornerRadius="12" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Risk Trend" FontSize="16" Foreground="{StaticResource TextGrayBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding RiskTrendIcon}" FontSize="36" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="{Binding Status.RiskTrend}" FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentCyanBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="System Risk Direction" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Anomalies -->
            <TextBlock Text="Top Anomalies" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="AnomaliesListView" Height="400" ItemsSource="{Binding TopAnomalies}" 
                      Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="15" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2" 
                                    BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource SecondaryRedBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Score: " FontSize="12" Foreground="{StaticResource TextGrayBrush}"/>
                                <TextBlock Text="{Binding Score}" FontSize="12" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                                <TextBlock Text=" | Source: " FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Timestamp}" 
                                       FontSize="11" Foreground="{StaticResource AccentCyanBrush}" 
                                       FontFamily="Consolas" Margin="0,5,0,0"/>
                            <ItemsControl ItemsSource="{Binding Patterns}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundNoiseBrush}" 
                                                Padding="5,2,5,2" Margin="0,2,5,2" CornerRadius="4">
                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

