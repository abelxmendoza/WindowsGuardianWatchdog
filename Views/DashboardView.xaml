<Page x:Class="WindowsGuardianWatchdog.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
  <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
    <StackPanel Padding="32" Spacing="22" MaxWidth="1500">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <guide:PageGuide Title="Home" Rank="1" Priority="Start here"
                         Summary="Start at the top of the list. Each step says how important it is and why it helps."
                         Why="Doing the first two steps covers the usual reasons a PC gets slow, cluttered, or less safe. You can stop there."/>
        <Button Grid.Column="1" Content="Check again" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"/>
      </Grid>

      <Border Style="{StaticResource HeroCardStyle}">
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="76" Height="76" CornerRadius="38" Background="#06213B" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
            <FontIcon x:Name="PostureIcon" Glyph="&#xE83D;" FontSize="36" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="HOW PROTECTED IS THIS PC" Style="{StaticResource EyebrowTextStyle}"/>
            <TextBlock x:Name="SecurityStatusText" Text="Checking this PC…" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock x:Name="SecuritySummaryText" Text="Looking at Windows' own virus protection and whether the PC looks healthy." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="SecurityScoreText" Text="—" FontSize="46" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="PROTECTION SCORE" Style="{StaticResource EyebrowTextStyle}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Virus protection" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="DefenderStatusText" Text="Checking…" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="Windows Defender. On means new files are watched." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Watching the PC" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="MonitorStatusText" Text="Not watching" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="Optional. Useful if the PC suddenly feels slow." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="PC health" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="SystemHealthText" Text="Checking…" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="Disk, memory, and whether Windows looks well." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Things to notice" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="AlertsCountText" Text="0" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="Only counts items that may need a look." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>

      <Border Style="{StaticResource SectionCardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="How to read the list" Style="{StaticResource SectionTitleTextStyle}"/>
          <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" Text="Do this first means it helps almost every PC. Recommended is worth doing when you have a minute. Optional is only if you want to look. Careful means an older app might stop working, so leave it off unless you know you want it."/>
        </StackPanel>
      </Border>

      <TextBlock Text="Do these in order" Style="{StaticResource SectionTitleTextStyle}"/>

      <Button Click="OpenUpdatesButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Do this first" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Update your apps" FontWeight="SemiBold"/>
            <TextBlock Text="Why: old apps are the usual way problems arrive. Newer versions also fix crashes." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button Click="OpenHardeningButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="2" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Do this first" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Turn on everyday protection" FontWeight="SemiBold"/>
            <TextBlock Text="Why: this uses Windows' own switches, such as virus protection and the firewall. Your files stay put." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button Click="OpenCleanupButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="3" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Recommended" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Free up space" FontWeight="SemiBold"/>
            <TextBlock Text="Why: leftover browser files and temporary files make a PC feel slower. Bookmarks and passwords stay." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button Click="OpenDriversButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="4" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Recommended" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Check hardware that is not working" FontWeight="SemiBold"/>
            <TextBlock Text="Why: a driver is the helper Windows uses to talk to a device. If that helper is stuck, the device will not work." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button Click="OpenStartupButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="5" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Optional" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="See what opens with Windows" FontWeight="SemiBold"/>
            <TextBlock Text="Why: too many startup programs make the PC slow to become ready. Turn off the ones you do not need every day." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button Click="OpenMonitorButton_Click" Style="{StaticResource ActionRowButtonStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="6" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="Optional" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="See what is running" FontWeight="SemiBold"/>
            <TextBlock Text="Why: if the PC feels slow, this shows which programs are busy. Windows itself is marked so you do not close it." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          </StackPanel>
          <FontIcon Grid.Column="3" Glyph="&#xE76C;" VerticalAlignment="Center"/>
        </Grid>
      </Button>

      <Border Style="{StaticResource SectionCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Only if you want a closer look" Style="{StaticResource SectionTitleTextStyle}"/>
          <TextBlock Text="These are optional. The list above is enough for everyday care." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="StartMonitoringButton" Content="Start watching this PC" Click="StartMonitoringButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Run a protection checkup" Click="RunAuditButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Look for known risks" Click="ThreatHuntButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
          </StackPanel>
          <TextBlock x:Name="OperationStatusText" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          <ProgressBar x:Name="OperationProgress" IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCardStyle}">
        <Grid RowSpacing="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="What just happened" Style="{StaticResource SectionTitleTextStyle}"/>
              <TextBlock Text="A short diary of checks from this visit. It stays on this PC." Style="{StaticResource BodyTextStyle}"/>
            </StackPanel>
            <Button Content="Open notices" Click="ViewAlertsButton_Click" HorizontalAlignment="Right" Style="{StaticResource TextButtonStyle}"/>
          </Grid>
          <ListView Grid.Row="1" x:Name="ActivityListView" MinHeight="220" Background="Transparent" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="4,9" ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Timestamp}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Type}" Style="{StaticResource EyebrowTextStyle}" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
