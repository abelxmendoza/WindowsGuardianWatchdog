<Page x:Class="WindowsGuardianWatchdog.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <!-- Logo Header -->
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/Logo.png" 
                       Width="120" Height="120" 
                       Stretch="Uniform"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WINDOWSGUARDIAN" 
                               FontSize="36" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    <TextBlock Text="WATCHDOG" 
                               FontSize="28" FontWeight="SemiBold" 
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,-10,0,0"/>
                    <TextBlock Text="Enterprise-Grade Security for Windows" 
                               FontSize="14" 
                               Foreground="{StaticResource TextGrayBrush}" 
                               Margin="0,10,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
            
            <!-- Status Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Margin="5" Padding="15" Background="{StaticResource BackgroundCardBrush}" CornerRadius="8" BorderBrush="{StaticResource ThemePurpleDarkBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Security Status" FontSize="14" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock x:Name="SecurityStatusText" Text="Checking..." FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Margin="5" Padding="15" Background="{StaticResource BackgroundCardBrush}" CornerRadius="8" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Active Threats" FontSize="14" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock x:Name="ThreatsCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SecondaryRedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Margin="5" Padding="15" Background="{StaticResource BackgroundCardBrush}" CornerRadius="8" BorderBrush="{StaticResource ThemePurpleDarkBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Files Monitored" FontSize="14" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock x:Name="FilesMonitoredText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="3" Margin="5" Padding="15" Background="{StaticResource BackgroundCardBrush}" CornerRadius="8" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Alerts" FontSize="14" Foreground="{StaticResource TextGrayBrush}"/>
                        <TextBlock x:Name="AlertsCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SecondaryRedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="StartMonitoringButton" Content="Start Monitoring" Click="StartMonitoringButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="RunAuditButton" Content="Run Security Audit" Click="RunAuditButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="ThreatHuntButton" Content="Threat Hunt" Click="ThreatHuntButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="ViewAlertsButton" Content="View Alerts" Click="ViewAlertsButton_Click" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>

            <!-- Recent Activity -->
            <TextBlock Text="Recent Activity" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
            <ListView x:Name="ActivityListView" Height="300" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Timestamp}" Width="150" FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="{Binding Message}" Margin="10,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

