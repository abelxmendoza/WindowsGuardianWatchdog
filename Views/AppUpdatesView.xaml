<Page x:Class="WindowsGuardianWatchdog.Views.AppUpdatesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="32" Spacing="18" MaxWidth="1500">
            <guide:PageGuide Title="Update apps" Rank="1" Priority="Do this first"
                             Summary="This finds newer versions of the apps you already have, then Windows updates."
                             Why="An app that has not been updated is the usual way a PC picks up problems or keeps crashing. Updating does not remove your files."/>

            <Border Style="{StaticResource HeroCardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="APPS" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="{Binding AppCountText}" FontSize="24" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="WINDOWS" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="{Binding WindowsCountText}" FontSize="24" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CheckButton" Content="See what is out of date" Command="{Binding CheckCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="UpgradeButton" Content="Update all apps" Command="{Binding UpgradeAppsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="WindowsButton" Content="Install Windows updates" Command="{Binding InstallWindowsCommand}" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <TextBlock Text="Apps that have a newer version" Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBlock Text="Importance: do these first. Each row is an app you already installed. The new version is the one Windows or the app store is offering." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding AppUpdates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding AvailableVersion}" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Source}" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Windows updates" Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBlock Text="Importance: recommended after the apps. These are fixes from Microsoft for Windows itself. A restart is sometimes needed at the end." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding WindowsUpdates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Log" Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" Style="{StaticResource DarkTextBoxStyle}" FontFamily="Consolas"/>
        </StackPanel>
    </ScrollViewer>
</Page>
