<Page x:Class="WindowsGuardianWatchdog.Views.AlertsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <!-- Security Alerts View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="Notices" Priority="Optional"
                             Summary="Notes this app wrote while you were using it."
                             Why="An empty list is normal. A notice means something changed or a check found an item worth reading. It does not mean the PC is unsafe by itself."/>
            
            <ListView x:Name="AlertsListView" Height="500" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" Foreground="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource TextGrayBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

