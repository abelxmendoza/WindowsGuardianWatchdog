<Page x:Class="WindowsGuardianWatchdog.Views.DriversView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="Fix hardware" Rank="4" Priority="Recommended"
                             Summary="Shows which devices are working and which ones need a restart or a newer helper program."
                             Why="A driver is the small program Windows uses to talk to hardware. Orange rows matter. A row that says Needs a restart will not get better until you restart the PC. Working rows can be ignored."/>
            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ScanButton" Content="Check devices again" Click="ScanButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                <Button Content="Ask Windows to look again" Click="HardwareButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                <Button Content="See if a newer helper exists" Click="CheckButton_Click"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                <Button Content="Install newer helpers" Click="InstallButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Foreground="{StaticResource AccentCyanBrush}" Margin="0,10,0,0"/>

            <TextBlock Text="Your devices, problems first" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="Orange means it needs you. Cyan means it is working. Importance is simple: fix orange rows, leave cyan rows alone." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
            <ListView x:Name="DriversListView" Height="500" ItemsSource="{Binding Drivers}" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Version: " FontSize="12" Foreground="{StaticResource TextGrayBrush}"/>
                                <TextBlock Text="{Binding DriverVersion}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text=" | Provider: " FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Provider}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text=" | " FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding IsHealthy, Converter={StaticResource BoolToStatusColorConverter}}"/>
                            </StackPanel>
                            <Button Content="Update" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}" 
                                    Click="UpdateButton_Click" Margin="0,5,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Driver updates" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <ListView Height="180" ItemsSource="{Binding AvailableUpdates}" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

