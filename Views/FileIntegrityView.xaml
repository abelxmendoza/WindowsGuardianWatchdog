<Page x:Class="WindowsGuardianWatchdog.Views.FileIntegrityView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- File Integrity Monitor View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/LogoMark.png" Width="64" Height="64" Stretch="UniformToFill"/>
                <TextBlock Text="File Integrity Monitor" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Spacing="10">
                <TextBlock Text="Monitored Paths" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="PathTextBox" PlaceholderText="Enter path to monitor (e.g., C:\Windows\System32)" Style="{StaticResource DarkTextBoxStyle}"/>
                <Button Content="Add Path" Click="AddPathButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                
                <Button Content="Create Baseline" Click="CreateBaselineButton_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button x:Name="StartMonitorButton" Content="Start Monitoring" Click="StartMonitorButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="StopMonitorButton" Content="Stop Monitoring" Click="StopMonitorButton_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Integrity Violations" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="ViolationsListView" Height="300" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" Foreground="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

