<Page x:Class="WindowsGuardianWatchdog.Views.ThreatDetectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Threat Detection View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                <Image Source="ms-appx:///Resources/Logo.png" Width="64" Height="64" Stretch="Uniform"/>
                <TextBlock Text="Threat Detection (Blue Team)" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryPurpleBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Button Content="Run Threat Hunt" Click="ThreatHuntButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>

            <TextBlock x:Name="ThreatReportText" Text="No threat hunt performed yet." Foreground="{StaticResource TextGrayBrush}" Margin="0,20,0,0"/>

            <TextBlock Text="Detected Threats" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="ThreatsListView" Height="400" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

