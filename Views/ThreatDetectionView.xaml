<Page x:Class="WindowsGuardianWatchdog.Views.ThreatDetectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <!-- Threat Detection View -->
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="Check for risks" Priority="Optional"
                             Summary="Looks through this PC for signs of a problem, then compares your apps with a public list of known issues."
                             Why="Most people do not need this every day. Use it if something feels wrong, or after you install an unfamiliar program. The public list shows titles and dates only. It does not download instructions for breaking into a computer."/>

            <Button Content="Look through this PC" Click="ThreatHuntButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>

            <TextBlock x:Name="ThreatReportText" Text="No threat hunt performed yet." Foreground="{StaticResource TextGrayBrush}" Margin="0,20,0,0"/>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,10,0,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Public list of known issues" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="Importance: informational. A match means a product you have has a publicly listed issue. It does not mean the PC is infected. Update that app from the Update apps page." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CatalogStatusText" Text="Catalog not loaded." Foreground="{StaticResource AccentCyanBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RefreshCatalogButton" Content="Download the latest list" Click="RefreshCatalogButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="MatchPcButton" Content="Compare with this PC" Click="MatchPcButton_Click" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogSearchBox" PlaceholderText="Search a product or CVE, for example CVE-2024-1234" Style="{StaticResource DarkTextBoxStyle}"/>
                        <Button Grid.Column="1" x:Name="SearchCatalogButton" Content="Search catalog" Click="SearchCatalogButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <ProgressBar x:Name="CatalogProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Exploit-DB matches" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="ExploitListView" Height="320" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Detected Threats" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="ThreatsListView" Height="400" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2" BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource SecondaryRedBrush}"/>
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

