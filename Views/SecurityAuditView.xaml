<Page x:Class="WindowsGuardianWatchdog.Views.SecurityAuditView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:guide="using:WindowsGuardianWatchdog.Components">
    <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
        <StackPanel Padding="20" Spacing="20" Background="{StaticResource BackgroundBlackBrush}">
            <guide:PageGuide Title="Protection checkup" Priority="Optional"
                             Summary="Gives this PC a simple score based on whether the main safety switches are on."
                             Why="A lower score means a switch is off, not that the PC is infected. Turn on protection, on the Home list, is the usual fix."/>

            <Button Content="Check this PC" Click="RunAuditButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,20,0,0">
                <TextBlock Text="Protection score:" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ScoreText" Text="N/A" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
            </StackPanel>

            <TextBlock Text="Audit Findings" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0"/>
            <ListView x:Name="FindingsListView" Height="400" Background="{StaticResource BackgroundNoiseBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="10" Background="{StaticResource BackgroundCardBrush}" Margin="0,2,0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextGrayBrush}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>

