<Page x:Class="WindowsGuardianWatchdog.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="{StaticResource BackgroundBlackBrush}">
    <StackPanel Padding="32" Spacing="22" MaxWidth="1000">
      <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Safety, privacy, and Windows integration" Style="{StaticResource BodyTextStyle}" Margin="0,6,0,0"/></StackPanel>
      <Border Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14"><TextBlock Text="Safety" Style="{StaticResource SectionTitleTextStyle}"/><ToggleSwitch x:Name="SafeModeToggle" Header="Safe mode" IsOn="True" Toggled="SafeModeToggle_Toggled" OnContent="Preview changes first" OffContent="Direct changes enabled"/><TextBlock Text="Safe mode keeps cleanup and remediation in preview or dry-run mode until you explicitly confirm an action." TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"/></StackPanel></Border>
      <Border Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Privacy" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Local-only by default" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Windows Guardian stores scan state, reports, and security findings on this PC. It does not upload telemetry or personal files. Network access is used only by features that explicitly update security intelligence or Windows protection data." TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"/></StackPanel></Border>
      <Border Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Permissions" Style="{StaticResource SectionTitleTextStyle}"/><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Administrator access" Message="Windows security controls, protected files, services, and firewall settings require elevation. Read-only views continue to report unavailable data instead of claiming the PC is safe."/></StackPanel></Border>
      <Border Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="8"><TextBlock Text="About" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="Windows Guardian Watchdog" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Version 1.0.0 · Native WinUI 3 · Windows 10 1809 and later" Style="{StaticResource BodyTextStyle}"/><TextBlock Text="Windows counterpart to LinuxGuardianWatchdog and MacGuardianWatchdog." Style="{StaticResource BodyTextStyle}"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</Page>
