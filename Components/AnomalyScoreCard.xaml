<UserControl x:Class="WindowsGuardianWatchdog.Components.AnomalyScoreCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="12" Padding="20" Background="{StaticResource BackgroundCardBrush}" 
            BorderBrush="{StaticResource SecondaryRedBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Anomaly Score" FontSize="18" Foreground="{StaticResource TextGrayBrush}"/>
            <TextBlock x:Name="ScoreText" Text="0/100" FontSize="42" FontWeight="Bold" 
                       Foreground="{StaticResource SecondaryRedBrush}" Margin="0,10,0,0"/>
            <TextBlock Text="Higher = More Anomalous" FontSize="12" 
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

