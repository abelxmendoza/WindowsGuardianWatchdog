<UserControl
    x:Class="WindowsGuardianWatchdog.Components.PageGuide"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="RankChip" Background="#123DFF" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="RankText" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border x:Name="PriorityChip" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="PriorityText" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextStyle}" FontSize="15" TextWrapping="Wrap"/>
        <Border Background="#07172C" BorderBrush="#1164B8" BorderThickness="1" CornerRadius="12" Padding="16">
            <StackPanel Spacing="4">
                <TextBlock Text="WHY THIS MATTERS" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock x:Name="WhyText" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
