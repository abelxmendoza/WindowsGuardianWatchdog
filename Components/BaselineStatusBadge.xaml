<UserControl x:Class="WindowsGuardianWatchdog.Components.BaselineStatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Padding="10,5" Background="{StaticResource BackgroundCardBrush}" 
            BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}"/>
            <TextBlock x:Name="StatusText" Text="NotTrained" FontWeight="SemiBold" 
                       Foreground="{StaticResource AccentCyanBrush}"/>
        </StackPanel>
    </Border>
</UserControl>

