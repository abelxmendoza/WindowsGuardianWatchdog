<Window x:Class="WindowsGuardianWatchdog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
        Title="Windows Guardian Watchdog">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BackgroundBlackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation View -->
        <muxc:NavigationView x:Name="NavView" Grid.Row="0" Grid.RowSpan="2"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsSettingsVisible="False"
                       Background="{StaticResource BackgroundNoiseBrush}">
            <muxc:NavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="15" Padding="20,10" Background="{StaticResource BackgroundNoiseBrush}">
                    <Image Source="ms-appx:///Resources/Logo.png" 
                           Width="60" Height="60" 
                           Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WINDOWSGUARDIAN" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryPurpleBrush}"/>
                        <TextBlock Text="WATCHDOG" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{StaticResource AccentCyanBrush}" Margin="0,-5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </muxc:NavigationView.Header>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="Dashboard"/>
                <muxc:NavigationViewItem Content="Security Overview" Tag="SecurityOverview"/>
                <muxc:NavigationViewItem Content="Security Monitor" Tag="SecurityMonitor"/>
                <muxc:NavigationViewItem Content="File Integrity" Tag="FileIntegrity"/>
                <muxc:NavigationViewItem Content="Threat Detection" Tag="ThreatDetection"/>
                <muxc:NavigationViewItem Content="Security Audit" Tag="SecurityAudit"/>
                <muxc:NavigationViewItem Content="Remediation" Tag="Remediation"/>
                <muxc:NavigationViewItem Content="System Cleanup" Tag="Cleanup"/>
                <muxc:NavigationViewItem Content="Drivers" Tag="Drivers"/>
                <muxc:NavigationViewItem Content="Startup Manager" Tag="Startup"/>
                <muxc:NavigationViewItem Content="Security Hardening" Tag="Hardening"/>
                <muxc:NavigationViewItem Content="ML Insights" Tag="MLInsights"/>
                <muxc:NavigationViewItem Content="Alerts" Tag="Alerts"/>
            </muxc:NavigationView.MenuItems>

            <muxc:Frame x:Name="ContentFrame" Content="Dashboard"/>
        </muxc:NavigationView>
    </Grid>
</Window>

