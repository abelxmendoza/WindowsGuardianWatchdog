<Application
    x:Class="WindowsGuardianWatchdog.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WindowsGuardianWatchdog.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/OmegaDarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter"/>
            
            <!-- Logo Resource -->
            <x:String x:Key="AppLogoPath">ms-appx:///Resources/LogoMark.png</x:String>
            
            <!-- Global Background -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#020711"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

