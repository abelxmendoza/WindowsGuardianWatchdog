<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Omega Technologies Dark Theme Colors - Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryPurpleBrush" Color="#1677FF"/>
    <SolidColorBrush x:Key="SecondaryRedBrush" Color="#FF8A16"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#00E2FF"/>
    <SolidColorBrush x:Key="TextGrayBrush" Color="#859BC0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF7FF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#91A9CC"/>
    <SolidColorBrush x:Key="BackgroundBlackBrush" Color="#020711"/>
    <SolidColorBrush x:Key="BackgroundNoiseBrush" Color="#050D1B"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="#081426"/>
    <SolidColorBrush x:Key="ThemePurpleBrush" Color="#0A55D9"/>
    <SolidColorBrush x:Key="ThemePurpleDarkBrush" Color="#0A2D70"/>
    <SolidColorBrush x:Key="ThemePurpleLightBrush" Color="#47BFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#07111F"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0B1B31"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#123C72"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00E2FF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFAD22"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6A21"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5F789F"/>
    <LinearGradientBrush x:Key="GuardianBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#123DFF" Offset="0"/><GradientStop Color="#00E2FF" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Button Styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GuardianBlueGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#C64E0B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BackgroundBlackBrush}"/>
    </Style>
    
    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundCardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemePurpleDarkBrush}"/>
    </Style>
    
    <!-- TextBlock Styles -->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryPurpleBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="32"/>
    </Style>
    
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style x:Key="AlertTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryRedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#00FF00"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    
    <!-- ListView Styles -->
    <Style x:Key="DarkListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource BackgroundNoiseBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <!-- TextBox Styles -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BackgroundCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemePurpleDarkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    
    <!-- ProgressBar Style -->
    <Style x:Key="CyanProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        <Setter Property="Background" Value="{StaticResource BackgroundCardBrush}"/>
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="80"/><Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#07172C"/><Setter Property="BorderBrush" Value="#1164B8"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/>
    </Style>
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource MetricCardStyle}">
        <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="16,9"/>
    </Style>
    <Style x:Key="ActionRowButtonStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="#09182A"/>
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="15,13"/>
    </Style>
    <Style x:Key="TextButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
    </Style>
    
</ResourceDictionary>

